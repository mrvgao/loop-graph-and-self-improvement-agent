# 复制成 .env（同目录）。也可以不用 .env，直接 export 到 shell —— llm.py 两种都认。
# 端点和 key 按下面的顺序找，第一个有值的胜出：
#   PARALLIGHT_BASE_URL / PARALLIGHT_API_KEY   课程网关
#   ANTHROPIC_BASE_URL  / ANTHROPIC_AUTH_TOKEN lab 环境（/lab-start 会 export，通常不用你填）
#   ANTHROPIC_BASE_URL  / ANTHROPIC_API_KEY    你自己的 key

PARALLIGHT_BASE_URL=https://lab-agent.parallight.ai/api/llm
PARALLIGHT_API_KEY=plk_...

# 主模型。课上用 claude-sonnet-5，开发和自己跑用便宜的。
# 换了 provider（比如 GLM）就填那个网关认的名字，preflight.py 会告诉你通不通。
MODEL=claude-haiku-4-5

# 第二个模型：a0 的判题者、c1 的采样者、c2 的写码者、c4 的路由者、c10 的学生。
# 留空 = 退回主模型，那四个演示的效果会打折（preflight.py 会当面说清楚代价）。
# 课程网关上填 claude-haiku-4-5；主模型已经是它的话，主模型换成 claude-sonnet-5。
# SMALL_MODEL=claude-haiku-4-5

# 你自己的题库（第二步用）：指向一个同结构的模块，a0/a1/a3/b0/c3/c7 全都跟着变
# LIVE_TASKS=mine.tasks
